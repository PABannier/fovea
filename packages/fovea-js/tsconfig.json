{
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": false,
    "lib": ["DOM", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "target": "ES2022"
  },
  "include": ["src/**/*.ts", "pkg/**/*.d.ts"]
}
